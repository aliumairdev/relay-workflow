#!/usr/bin/env node
// PreToolUse(Write|Edit|MultiEdit): block content that looks like a secret. Never prints the matched value.
import fs from 'node:fs';
import crypto from 'node:crypto';
import { guard, allow, deny, toRegExp } from '../lib/hooklib.mjs';
import { expandHome } from '../lib/config.mjs';

const BUILTIN = [
  ['private key block', /-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----/],
  ['AWS access key id', /\bAKIA[0-9A-Z]{16}\b/],
  ['GitHub token', /\bgh[pousr]_[A-Za-z0-9]{30,}\b/],
  ['API key (sk-)', /\bsk-[A-Za-z0-9_-]{20,}\b/],
  ['Slack token', /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/],
];
const ASSIGN = /\b(?:secret|token|passw(?:or)?d|passwd|api[_-]?key|private[_-]?key|access[_-]?key)\w*\s*[:=]\s*["']?([A-Za-z0-9+/=_.-]{20,})["']?/gi;

const entropy = (s) => { const f = {}; for (const c of s) f[c] = (f[c] || 0) + 1; return -Object.values(f).reduce((a, n) => a + (n / s.length) * Math.log2(n / s.length), 0); };
// process.env.API_TOKEN, config.api.key, os.environ.TOKEN: references, not values
const isPropertyPath = (v) => v.includes('.') && v.split('.').every((p) => /^[A-Za-z_][A-Za-z0-9_]*$/.test(p));
const sha = (s) => crypto.createHash('sha256').update(s).digest('hex');

function contentOf(input) {
  if (typeof input.content === 'string') return input.content;
  if (typeof input.new_string === 'string') return input.new_string;
  if (Array.isArray(input.edits)) return input.edits.map((e) => e.new_string || '').join('\n');
  return '';
}

guard('secret-guard', (payload, cfg) => {
  if (!cfg || !['Write', 'Edit', 'MultiEdit'].includes(payload.tool_name)) return allow();
  const text = contentOf(payload.tool_input || {});
  if (!text) return allow();
  const found = [];
  const lineOf = (i) => text.slice(0, i).split('\n').length;
  for (const [name, re] of BUILTIN) { const m = re.exec(text); if (m) found.push(`${name} (line ${lineOf(m.index)})`); }
  for (const p of cfg.security?.secret_patterns || []) {
    let re; try { re = toRegExp(p); } catch { continue; }
    const m = re.exec(text); if (m) found.push(`configured pattern /${p.slice(0, 30)}/ (line ${lineOf(m.index)})`);
  }
  for (const m of text.matchAll(ASSIGN)) if (entropy(m[1]) > 3.6 && !/^(?:[a-z]+_)+[a-z]+$/i.test(m[1]) && !isPropertyPath(m[1])) found.push(`high-entropy value assigned to a secret-like name (line ${lineOf(m.index)})`);
  const hf = cfg.security?.secret_hash_list_file && expandHome(cfg.security.secret_hash_list_file);
  if (hf && fs.existsSync(hf)) {
    const known = new Set(fs.readFileSync(hf, 'utf8').split(/\s+/).filter(Boolean));
    for (const tok of text.match(/[A-Za-z0-9+/=_.-]{8,}/g) || []) if (known.has(sha(tok))) { found.push('a known secret (hash list)'); break; }
  }
  if (!found.length) return allow();
  deny(`secret-guard: the content looks like it contains a secret: ${[...new Set(found)].join('; ')}. The value was not written. Read it from an environment variable (or an ephemeral file outside the repo) and write only the variable name.`);
});
