{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review packet",
  "type": "object",
  "required": [
    "kind",
    "target",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "review",
        "decision"
      ]
    },
    "target": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
