#!/usr/bin/env node
// relay-pr open (--body-file F | --body T) [--title T] [--issue N] [--base B]
// Opens the PR for the current branch through the control plane (no `gh` CLI needed). Runtime-neutral and token-light.
import fs from 'node:fs';
import { parse, out, run } from '../lib/cli.mjs';
import { ctx } from '../lib/ctx.mjs';
import { git } from '../lib/exec.mjs';
import { lint } from '../lib/evidence.mjs';
import { RelayError, EXIT } from '../lib/exit.mjs';

run(async () => {
  const { flags, args } = parse(process.argv.slice(2), { 'body-file': { type: 'string' }, body: { type: 'string' }, title: { type: 'string' }, issue: { type: 'string' }, base: { type: 'string' } });
  if (args[0] !== 'open') throw new RelayError('usage: relay-pr open (--body-file F | --body T) [--title T] [--issue N] [--base B]', EXIT.INVALID);
  const { cfg, cp } = ctx();
  const branch = git(['rev-parse', '--abbrev-ref', 'HEAD']).stdout.trim();
  const issue = Number(flags.issue || (/^agent\/[^/]+\/(\d+)-/.exec(branch) || [])[1]);
  if (!branch || branch === 'HEAD' || branch === cfg.project.default_branch) throw new RelayError(`refused: not on a work branch (on "${branch}")`, EXIT.REFUSED);
  const body = flags['body-file'] ? fs.readFileSync(flags['body-file'], 'utf8') : flags.body;
  if (!body) throw new RelayError('a PR body is required: fill in the PR template (outcome, validation with real results, NOT_VERIFIED) and pass --body-file', EXIT.INVALID);
  if (issue && !new RegExp(`closes\\s+#${issue}\\b`, 'i').test(body)) throw new RelayError(`the PR body must contain "Closes #${issue}"`, EXIT.INVALID);
  if (cfg.honesty?.evidence_lint !== false) { const bad = lint(body, { kind: 'pr' }); if (bad.length) throw new RelayError(`PR body fails the evidence lint: ${bad.map((b) => b.message).join('; ')}`, EXIT.INVALID); }
  if (git(['ls-remote', '--exit-code', '--heads', 'origin', branch]).code !== 0) { const p = git(['push', '-u', 'origin', branch]); if (p.code !== 0) throw new RelayError(`push failed: ${p.stderr.trim().split('\n')[0]}`, EXIT.ENV); }
  const existing = cp.listPRs('open').find((p) => (p.head?.ref || p.pull_request?.head?.ref) === branch);
  if (existing) { out(flags, { number: existing.number, existing: true }, `PR #${existing.number} already open for ${branch}`); return EXIT.OK; }
  if (flags['dry-run']) { out(flags, { dry_run: true, branch, issue }); return EXIT.OK; }
  const title = flags.title || (issue ? `${cp.getIssue(issue).title}` : branch);
  const pr = cp.createPR({ title, body, head: branch, base: flags.base || cfg.project.default_branch });
  out(flags, { number: pr.number, url: pr.html_url, branch }, `opened PR #${pr.number} for ${branch}`);
  return EXIT.OK;
});
